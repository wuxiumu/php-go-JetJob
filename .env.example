# JetJob 环境变量总表（占位符）。各进程读取自己目录里的文件，不会自动读本文件。
# 复制后再改口令，不要提交填好的 .env。
#
#   cp backend-php7.4/.env.example backend-php7.4/.env
#   cp frontend-vue3.5.13/.env.example frontend-vue3.5.13/.env.development
#   cp scheduler-go1.24.2/.env.example scheduler-go1.24.2/.env
#   cp scheduler-go1.24.2/config/config.yaml.example scheduler-go1.24.2/config/config.yaml
#
# 根目录 docker compose 只插值下面的 MYSQL_* / REDIS_PORT，用来启动 MySQL 与 Redis。

# --- Compose：仅 MySQL / Redis ---
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=jetjob
MYSQL_PORT=3306
REDIS_PORT=6379

# --- PHP（backend-php7.4/.env）---
APP_NAME=JetJob
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jetjob
DB_USERNAME=root
DB_PASSWORD=changeme
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
JWT_SECRET=change-me-jwt-secret

# --- Vue（frontend-vue3.5.13/.env.development）---
# 登录页请求 ${VITE_API_BASE}/login。对接 cmd/scheduler 时使用下一行。
VITE_API_BASE=http://127.0.0.1:8090/api

# --- Go 调度（scheduler-go1.24.2/.env，由 cmd/scheduler 读取）---
JETJOB_MYSQL_DSN=root:changeme@tcp(127.0.0.1:3306)/jetjob?charset=utf8mb4&parseTime=True&loc=Local
JETJOB_REDIS_ADDR=127.0.0.1:6379
JETJOB_TOKEN=test-token
# 依赖数据库的 Go 测试才需要。留空时这些测试会失败并提示未配置。
JETJOB_TEST_DSN=
